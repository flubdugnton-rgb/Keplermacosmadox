diff --git a/Tests/KeychainInteractionTests.swift b/Tests/KeychainInteractionTests.swift
new file mode 100644
--- /dev/null
+++ b/Tests/KeychainInteractionTests.swift
@@ -0,0 +1,33 @@
+import XCTest
+import Security
+import GTMAppAuth
+
+final class KeychainInteractionTests: XCTestCase {
+    func testAutomaticAccessFailsInsteadOfOpeningPasswordPrompt() {
+        let helper = NoninteractiveKeychainHelper(keychainAttributes: [.useFileBasedKeychain])
+        let query = helper.keychainQuery(forService: "test-service")
+        XCTAssertEqual(query[kSecUseAuthenticationUI as String] as? String, kSecUseAuthenticationUIFail as String)
+        XCTAssertEqual(query[kSecAttrService as String] as? String, "test-service")
+        XCTAssertEqual(query[kSecAttrAccount as String] as? String, "OAuth")
+        XCTAssertEqual(query[kSecUseDataProtectionKeychain as String] as? Bool, false)
+        // O wrapper não instala ACLs permissivas nem transfere tokens para arquivos.
+        XCTAssertNil(query[kSecAttrAccess as String])
+        XCTAssertNil(query[kSecAttrAccessGroup as String])
+    }
+
+    func testLegacyInteractionFlagIsRestoredEvenWhenTheOperationThrows() throws {
+        enum ExpectedFailure: Error { case test }
+        let helper = NoninteractiveKeychainHelper(keychainAttributes: [.useFileBasedKeychain])
+        var before: DarwinBoolean = false
+        XCTAssertEqual(SecKeychainGetUserInteractionAllowed(&before), errSecSuccess)
+        XCTAssertThrowsError(try helper.withInteractionDisabled {
+            var during: DarwinBoolean = true
+            XCTAssertEqual(SecKeychainGetUserInteractionAllowed(&during), errSecSuccess)
+            XCTAssertFalse(during.boolValue)
+            throw ExpectedFailure.test
+        })
+        var after: DarwinBoolean = false
+        XCTAssertEqual(SecKeychainGetUserInteractionAllowed(&after), errSecSuccess)
+        XCTAssertEqual(after.boolValue, before.boolValue)
+    }
+}
